rules_version = '2';

// Security rules for the Caramel Cottage retail system. The contract is
// docs/04-PERMISSIONS.md; rule numbers (#1 ... #21) refer to it. Anything not
// matched below is denied (#1).
//
// Two budgets apply to every rule evaluation:
// - Access calls: me() and role() cost 2 and are counted once per request,
//   however often they're used. Keep every other get()/exists() in a rule to
//   the docs that rule is about.
// - Evaluated expressions: at most 1000 per rule evaluation (per document in a
//   batch). Unrolled per-line checks are what use it up: the largest bill
//   (15 lines, 4 payments) and the largest return update (15 products) are
//   the tight spots, and BE-6 tests them (D-030, CR-001). Guard unrolled checks with ?: so
//   only the entries that exist are evaluated, and keep per-entry checks to
//   what the contract needs.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Paths ---------------------------------------------------------

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }
    function rolePath(roleId) {
      return /databases/$(database)/documents/roles/$(roleId);
    }
    function locationPath(loc) {
      return /databases/$(database)/documents/locations/$(loc);
    }
    function devicePath(loc, deviceId) {
      return /databases/$(database)/documents/locations/$(loc)/devices/$(deviceId);
    }
    function orderPath(loc, orderId) {
      return /databases/$(database)/documents/locations/$(loc)/orders/$(orderId);
    }

    // ---- Who is asking (04-PERMISSIONS helper functions) ----------------

    function signedIn() {
      return request.auth != null;
    }
    function me() {
      return get(userPath(request.auth.uid)).data;
    }
    function role() {
      return get(rolePath(me().roleId)).data;
    }
    // exists() and get() on the same doc count as one access call.
    function active() {
      return signedIn() && exists(userPath(request.auth.uid)) && me().active == true;
    }
    function can(p) {
      return active() && p in role().permissions;
    }
    function atLoc(loc) {
      return role().allLocations == true || me().locationId == loc;
    }
    // canAt() binds the user and role docs once: every evaluated expression
    // counts towards the limit of 1000 per rule, and the big batches need
    // the headroom.
    function canAt(p, loc) {
      return signedIn() && exists(userPath(request.auth.uid)) && canAtAs(get(userPath(request.auth.uid)).data, p, loc);
    }
    function canAtAs(u, p, loc) {
      return u.active == true && canAtWith(u, get(rolePath(u.roleId)).data, p, loc);
    }
    function canAtWith(u, r, p, loc) {
      return p in r.permissions && (r.allLocations == true || u.locationId == loc);
    }
    function activeAt(loc) {
      return active() && atLoc(loc);
    }

    // ---- Write helpers -------------------------------------------------

    function incoming() {
      return request.resource.data;
    }
    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    function isLocationCode(s) {
      return s is string && s.matches('^[A-Z]{2,4}$');
    }
    // `D01` for device number 1 (Ids.deviceCode).
    function deviceCode(n) {
      return n < 10 ? 'D0' + string(n) : 'D' + string(n);
    }

    // ---- #2 roles: any signed-in user, active or not. No client writes ----

    match /roles/{roleId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // ---- #3 users --------------------------------------------------------

    function validUserFields(d) {
      return d.name is string && d.name.size() > 0
        && d.email is string
        && d.roleId is string && exists(rolePath(d.roleId))
        && d.active is bool
        && (d.locationId == null || (isLocationCode(d.locationId) && exists(locationPath(d.locationId))));
    }

    match /users/{uid} {
      // A signed-in user can always read their own doc, even when inactive,
      // so sign-in can tell userDisabled from noProfile.
      allow get: if (signedIn() && request.auth.uid == uid) || can('user.manage');
      allow list: if can('user.manage');

      allow create: if can('user.manage')
        && incoming().keys().hasOnly(['name', 'email', 'roleId', 'locationId', 'active', 'createdAt', 'createdBy'])
        && incoming().keys().hasAll(['name', 'email', 'roleId', 'locationId', 'active', 'createdAt', 'createdBy'])
        && validUserFields(incoming())
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time;

      // Nobody changes their own roleId, locationId or active, managers
      // included, so an Admin can't lock themselves out by mistake.
      allow update: if can('user.manage')
        && changed().hasOnly(['name', 'email', 'roleId', 'locationId', 'active'])
        && validUserFields(incoming())
        && (request.auth.uid != uid || !changed().hasAny(['roleId', 'locationId', 'active']));

      // Users are disabled (active: false), never deleted.
      allow delete: if false;
    }

    // ---- #4 locations and devices ---------------------------------------

    function validLocationFields(d) {
      return d.name is string && d.name.size() > 0
        && d.address is string
        && d.phone is string
        && (d.gstin == null || d.gstin is string)
        && d.offlineLimitHours is int && d.offlineLimitHours > 0
        && d.overridePinHash is string
        && d.overrideExtensionHours is int && d.overrideExtensionHours > 0
        && (d.maxDiscountPct == null || (d.maxDiscountPct is int && d.maxDiscountPct >= 0 && d.maxDiscountPct <= 100))
        && d.receiptFooter is string
        && d.active is bool;
    }

    function locationKeys() {
      return ['code', 'name', 'address', 'phone', 'gstin', 'offlineLimitHours',
              'overridePinHash', 'overrideExtensionHours', 'maxDiscountPct',
              'receiptFooter', 'nextDeviceNo', 'active'];
    }

    // Device registration: nextDeviceNo goes up by exactly 1, and the
    // transaction creates devices/D{new value}, which didn't exist before.
    function isRegistration(loc) {
      let next = incoming().nextDeviceNo;
      return canAt('device.register', loc)
        && changed().hasOnly(['nextDeviceNo'])
        && next == resource.data.nextDeviceNo + 1
        && next <= 99
        && !exists(devicePath(loc, deviceCode(next)))
        && existsAfter(devicePath(loc, deviceCode(next)));
    }

    // ---- #14 customers: the write helpers ---------------------------------

    function customerKeys() {
      return ['name', 'phone', 'whatsapp', 'lastBillAt', 'billCount', 'totalSpend', 'lastWriteRef'];
    }
    // The bill that caused this customer write: `lastWriteRef` is its ID, and
    // the batch creates it. Same docs as the bill rules read, so no new access
    // calls beyond the one for the new bill (exists, getAfter).
    function customerBill(loc) {
      return getAfter(billPath(loc, incoming().lastWriteRef)).data;
    }
    // Shared by create and update. The customer doc says what the new bill
    // says (the same id, name, phone and WhatsApp number), the id's phone part
    // is the phone field, and lastBillAt is the server time. A set(merge)
    // always sends the name, so a later bill that spells the name in another
    // letter case (the same customerId) is accepted and updates the name, while
    // any other change of name is not (rule above, in update).
    function validCustomerWrite(loc, customerId, b) {
      let c = incoming();
      let ref = c.lastWriteRef;
      return canAt('bill.create', loc)
        && c.keys().hasOnly(customerKeys())
        && c.keys().hasAll(customerKeys())
        && ref is string && ref.matches('^D[0-9]{2}-[0-9]{6}$')
        && !exists(billPath(loc, ref))
        && existsAfter(billPath(loc, ref))
        && customerId.matches('^[6-9][0-9]{9}_[0-9a-f]{10}$')
        && customerId.matches('^' + c.phone + '_.*')
        && b.customerId == customerId
        && c.name == b.customerName
        && c.phone == b.customerPhone
        && c.whatsapp == b.customerWhatsapp
        && c.lastBillAt == request.time;
    }

    // ---- #15 staff roster, #16 attendance (D-042) ------------------------

    function staffKeys() {
      return ['name', 'role', 'active', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt'];
    }
    function validStaffName(n) {
      return n is string && n.size() >= 1 && n.size() <= 60;
    }
    // #15 create: an auto-ID document the Admin adds. `updatedBy` and
    // `updatedAt` are optional on create and, when given, are the writer and
    // the server time.
    function validNewStaff(loc) {
      let d = incoming();
      return canAt('staff.manage', loc)
        && d.keys().hasOnly(staffKeys())
        && d.keys().hasAll(['name', 'role', 'active', 'createdBy', 'createdAt'])
        && validStaffName(d.name)
        && d.role is string && d.role.size() <= 30
        && d.active is bool
        && d.createdBy == request.auth.uid
        && d.createdAt == request.time
        && (!d.keys().hasAny(['updatedBy']) || d.updatedBy == request.auth.uid)
        && (!d.keys().hasAny(['updatedAt']) || d.updatedAt == request.time);
    }
    // #15 update: only the editable fields and the update stamp. Whatever
    // the edit leaves alone stays valid because it was valid when created.
    function validStaffUpdate(loc) {
      let d = incoming();
      let ch = changed();
      return canAt('staff.manage', loc)
        && ch.hasOnly(['name', 'role', 'active', 'updatedBy', 'updatedAt'])
        // updatedAt is the server time, so it always changes; updatedBy
        // doesn't when the same person edits twice.
        && ch.hasAll(['updatedAt'])
        && validStaffName(d.name)
        && d.role is string && d.role.size() <= 30
        && d.active is bool
        && d.updatedBy == request.auth.uid
        && d.updatedAt == request.time;
    }
    function attendanceKeys() {
      return ['staffId', 'staffName', 'businessDate', 'status', 'note', 'markedBy', 'deviceId', 'editedAt'];
    }
    // #16. The doc ID is `{businessDate}_{staffId}`, and the doc says the
    // same. The roster is not read (a batch of 15 marks must stay inside the
    // access-call budget) and the date window is the client's (D-031).
    function validAttendance(docId) {
      let d = incoming();
      return d.keys().hasOnly(attendanceKeys())
        && d.keys().hasAll(['staffId', 'staffName', 'businessDate', 'status', 'markedBy', 'deviceId', 'editedAt'])
        && isBusinessDate(d.businessDate)
        && d.staffId is string && isSafeKey(d.staffId)
        && docId == d.businessDate + '_' + d.staffId
        && d.status in ['PRESENT', 'ABSENT', 'HALF_DAY']
        && (d.get('note', null) == null || (d.note is string && d.note.size() <= 100))
        && validStaffName(d.staffName)
        && d.markedBy is map
        && d.markedBy.keys().hasOnly(['uid', 'name'])
        && d.markedBy.uid == request.auth.uid
        && d.markedBy.name is string
        && d.deviceId is string && d.deviceId.matches('^D[0-9]{2}$')
        && d.editedAt == request.time;
    }

    // ---- #18 pre-orders (D-043) ---------------------------------------------

    function orderKeys() {
      return ['orderNo', 'deviceId', 'seq', 'customerId', 'customerName', 'customerPhone',
              'customerWhatsapp', 'dueDate', 'dueTime', 'description', 'price', 'advance',
              'advanceMode', 'status', 'billId', 'servedBy', 'businessDate',
              'clientCreatedAt', 'serverCreatedAt', 'createdBy'];
    }
    // #18 create. orderId is `D01-O000007` and must agree with deviceId, seq
    // and orderNo; the device is a registered one whose lastOrderSeq becomes
    // this seq in the same batch (#4).
    function validNewOrder(loc, orderId) {
      let o = incoming();
      let keys = orderKeys();
      return orderId.matches('^D[0-9]{2}-O[0-9]{6}$')
        && o.keys().hasOnly(keys.concat(['deliveredAt']))
        && o.keys().hasAll(keys)
        && o.get('deliveredAt', null) == null
        && o.orderNo == loc + '-' + orderId
        && o.deviceId == orderId.split('-')[0]
        && o.seq is int && o.seq > 0
        && orderId.matches('^D[0-9]{2}-O0*' + string(o.seq) + '$')
        && exists(devicePath(loc, o.deviceId))
        && getAfter(devicePath(loc, o.deviceId)).data.lastOrderSeq == o.seq
        && o.createdBy == request.auth.uid
        && o.status == 'OPEN'
        && o.billId == null
        && validBillCustomer(o)
        && isBusinessDate(o.dueDate)
        && (o.dueTime == null || (o.dueTime is string && o.dueTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')))
        && o.description is string && o.description.size() >= 1 && o.description.size() <= 500
        && o.price is int && o.price > 0 && o.price % 100 == 0
        && o.advance is int && o.advance % 100 == 0 && o.advance >= 0 && o.advance <= o.price
        && (o.advance == 0
          ? o.advanceMode == null
          : o.advanceMode in ['CASH', 'UPI', 'CARD', 'WALLET', 'OTHER'])
        && o.servedBy is map
        && isBusinessDate(o.businessDate)
        && o.clientCreatedAt is timestamp
        && o.serverCreatedAt == request.time;
    }
    // #18 (a): delivery. The order goes OPEN -> DELIVERED with the bill that
    // is new in this batch and says it delivers this order (#19 checks the
    // other half).
    function isOrderDeliver(loc, orderId) {
      let ch = changed();
      let bid = incoming().billId;
      return ch.hasOnly(['status', 'billId', 'deliveredAt'])
        && ch.hasAll(['status', 'billId', 'deliveredAt'])
        && canAt('order.manage', loc)
        && resource.data.status == 'OPEN'
        && incoming().status == 'DELIVERED'
        && bid is string && bid.matches('^D[0-9]{2}-[0-9]{6}$')
        && !exists(billPath(loc, bid))
        && existsAfter(billPath(loc, bid))
        && getAfter(billPath(loc, bid)).data.get('orderId', null) == orderId
        && incoming().deliveredAt == request.time;
    }
    // #18 (b): cancellation of an open order, with its audit entry.
    function isOrderCancel(loc, orderId) {
      let ch = changed();
      let c = incoming().cancel;
      return ch.hasOnly(['status', 'cancel'])
        && ch.hasAll(['status', 'cancel'])
        && canAt('order.manage', loc)
        && resource.data.status == 'OPEN'
        && incoming().status == 'CANCELLED'
        && c is map
        && c.keys().hasOnly(['reason', 'by', 'at', 'businessDate', 'refunded'])
        && c.keys().hasAll(['reason', 'by', 'at', 'businessDate', 'refunded'])
        && c.reason is string && c.reason.size() >= 1 && c.reason.size() <= 100
        && c.by == request.auth.uid
        && c.at is timestamp
        && isBusinessDate(c.businessDate)
        && c.refunded is int && c.refunded % 100 == 0
        && c.refunded >= 0 && c.refunded <= resource.data.advance
        && existsAfter(auditPath(loc + '-' + orderId + '-X'));
    }

    // ---- #5-6 bills --------------------------------------------------------
    // The rules language has no loops, so per-line and per-key checks are
    // unrolled up to the caps in Limits (D-030): 15 lines, 4 payments.

    function billPath(loc, billId) {
      return /databases/$(database)/documents/locations/$(loc)/bills/$(billId);
    }
    function returnPath(loc, returnId) {
      return /databases/$(database)/documents/locations/$(loc)/returns/$(returnId);
    }
    function movementPath(loc, movementId) {
      return /databases/$(database)/documents/locations/$(loc)/movements/$(movementId);
    }
    function auditPath(auditId) {
      return /databases/$(database)/documents/auditLog/$(auditId);
    }

    function isBusinessDate(s) {
      return s is string && s.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // Line i: well formed, lineTotal = qty x unitPrice, and soldQty carries
    // exactly this line's qty. soldQty.size() == lines.size() then also rules
    // out two lines for one product (D-024).
    // Checks over list entries are unrolled up to the cap (15 lines on a
    // bill, D-030), and only the entries that exist are evaluated: every
    // evaluated expression counts towards Firestore's limit of 1000 per rule
    // evaluation (CR-001), so the unrolled code dispatches on size() with ?:
    // rather than guarding each of the 15 slots.

    // The soldQty a bill must carry: {productId: qty} built from its lines,
    // one literal per line count. Two lines for one product collapse into
    // one key, so the size check below catches them (D-024 (e), QA-033).
    function soldFromLines1to5(ls) {
      return ls.size() == 1 ? {ls[0].productId: ls[0].qty}
        : ls.size() == 2 ? {ls[0].productId: ls[0].qty, ls[1].productId: ls[1].qty}
        : ls.size() == 3 ? {ls[0].productId: ls[0].qty, ls[1].productId: ls[1].qty, ls[2].productId: ls[2].qty}
        : ls.size() == 4 ? {ls[0].productId: ls[0].qty, ls[1].productId: ls[1].qty, ls[2].productId: ls[2].qty, ls[3].productId: ls[3].qty}
        : ls.size() == 5 ? {ls[0].productId: ls[0].qty, ls[1].productId: ls[1].qty, ls[2].productId: ls[2].qty, ls[3].productId: ls[3].qty, ls[4].productId: ls[4].qty}
        : soldFromLines6to10(ls);
    }
    function soldFromLines6to10(ls) {
      return ls.size() == 6 ? {ls[0].productId: ls[0].qty, ls[1].productId: ls[1].qty, ls[2].productId: ls[2].qty, ls[3].productId: ls[3].qty, ls[4].productId: ls[4].qty, ls[5].productId: ls[5].qty}
        : ls.size() == 7 ? {ls[0].productId: ls[0].qty, ls[1].productId: ls[1].qty, ls[2].productId: ls[2].qty, ls[3].productId: ls[3].qty, ls[4].productId: ls[4].qty, ls[5].productId: ls[5].qty, ls[6].productId: ls[6].qty}
        : ls.size() == 8 ? {ls[0].productId: ls[0].qty, ls[1].productId: ls[1].qty, ls[2].productId: ls[2].qty, ls[3].productId: ls[3].qty, ls[4].productId: ls[4].qty, ls[5].productId: ls[5].qty, ls[6].productId: ls[6].qty, ls[7].productId: ls[7].qty}
        : ls.size() == 9 ? {ls[0].productId: ls[0].qty, ls[1].productId: ls[1].qty, ls[2].productId: ls[2].qty, ls[3].productId: ls[3].qty, ls[4].productId: ls[4].qty, ls[5].productId: ls[5].qty, ls[6].productId: ls[6].qty, ls[7].productId: ls[7].qty, ls[8].productId: ls[8].qty}
        : ls.size() == 10 ? {ls[0].productId: ls[0].qty, ls[1].productId: ls[1].qty, ls[2].productId: ls[2].qty, ls[3].productId: ls[3].qty, ls[4].productId: ls[4].qty, ls[5].productId: ls[5].qty, ls[6].productId: ls[6].qty, ls[7].productId: ls[7].qty, ls[8].productId: ls[8].qty, ls[9].productId: ls[9].qty}
        : soldFromLines11to15(ls);
    }
    function soldFromLines11to15(ls) {
      return ls.size() == 11 ? {ls[0].productId: ls[0].qty, ls[1].productId: ls[1].qty, ls[2].productId: ls[2].qty, ls[3].productId: ls[3].qty, ls[4].productId: ls[4].qty, ls[5].productId: ls[5].qty, ls[6].productId: ls[6].qty, ls[7].productId: ls[7].qty, ls[8].productId: ls[8].qty, ls[9].productId: ls[9].qty, ls[10].productId: ls[10].qty}
        : ls.size() == 12 ? {ls[0].productId: ls[0].qty, ls[1].productId: ls[1].qty, ls[2].productId: ls[2].qty, ls[3].productId: ls[3].qty, ls[4].productId: ls[4].qty, ls[5].productId: ls[5].qty, ls[6].productId: ls[6].qty, ls[7].productId: ls[7].qty, ls[8].productId: ls[8].qty, ls[9].productId: ls[9].qty, ls[10].productId: ls[10].qty, ls[11].productId: ls[11].qty}
        : ls.size() == 13 ? {ls[0].productId: ls[0].qty, ls[1].productId: ls[1].qty, ls[2].productId: ls[2].qty, ls[3].productId: ls[3].qty, ls[4].productId: ls[4].qty, ls[5].productId: ls[5].qty, ls[6].productId: ls[6].qty, ls[7].productId: ls[7].qty, ls[8].productId: ls[8].qty, ls[9].productId: ls[9].qty, ls[10].productId: ls[10].qty, ls[11].productId: ls[11].qty, ls[12].productId: ls[12].qty}
        : ls.size() == 14 ? {ls[0].productId: ls[0].qty, ls[1].productId: ls[1].qty, ls[2].productId: ls[2].qty, ls[3].productId: ls[3].qty, ls[4].productId: ls[4].qty, ls[5].productId: ls[5].qty, ls[6].productId: ls[6].qty, ls[7].productId: ls[7].qty, ls[8].productId: ls[8].qty, ls[9].productId: ls[9].qty, ls[10].productId: ls[10].qty, ls[11].productId: ls[11].qty, ls[12].productId: ls[12].qty, ls[13].productId: ls[13].qty}
        : {ls[0].productId: ls[0].qty, ls[1].productId: ls[1].qty, ls[2].productId: ls[2].qty, ls[3].productId: ls[3].qty, ls[4].productId: ls[4].qty, ls[5].productId: ls[5].qty, ls[6].productId: ls[6].qty, ls[7].productId: ls[7].qty, ls[8].productId: ls[8].qty, ls[9].productId: ls[9].qty, ls[10].productId: ls[10].qty, ls[11].productId: ls[11].qty, ls[12].productId: ls[12].qty, ls[13].productId: ls[13].qty, ls[14].productId: ls[14].qty};
    }

    // #6: 1-15 lines, one per product, and soldQty is exactly those
    // products with those quantities, no key missing and none extra. Line
    // arithmetic and positive quantities are the client's (BillCalculator);
    // soldQty only has to be right for the return cap (#5b).
    function billLinesOk(ls, sold) {
      let expected = ls is list && ls.size() >= 1 && ls.size() <= 15 ? soldFromLines1to5(ls) : null;
      return expected != null
        && expected.size() == ls.size()
        && sold == expected;
    }

    // Payments (and refunds): at most 4, adding up to exactly [total]. An
    // empty list sums to 0. Modes and positive amounts are the client's.
    function paymentsOk(ps, total) {
      return ps is list && ps.size() <= 4
        && (ps.size() == 0 ? total == 0
          : ps.size() == 1 ? ps[0].amount == total
          : ps.size() == 2 ? ps[0].amount + ps[1].amount == total
          : ps.size() == 3 ? ps[0].amount + ps[1].amount + ps[2].amount == total
          : ps[0].amount + ps[1].amount + ps[2].amount + ps[3].amount == total);
    }

    function billKeys() {
      return ['billNo', 'deviceId', 'seq', 'lines', 'subtotal', 'discount', 'taxableValue',
              'taxLines', 'roundOff', 'total', 'payments', 'cashTendered', 'status', 'cancel',
              'returnedQty', 'soldQty', 'lastReturnId', 'servedBy', 'businessDate',
              'clientCreatedAt', 'serverCreatedAt', 'createdBy',
              'customerId', 'customerName', 'customerPhone', 'customerWhatsapp'];
    }

    // #19. A bill may also carry `orderId` (D-043): absent or null for an
    // ordinary bill.
    function billOptionalKeys() {
      return ['orderId'];
    }

    // The ADVANCE entries of a payment list (#19): how many, and their sum.
    // Unrolled to the cap of 4 payments, dispatching on size() like
    // paymentsOk.
    function isAdv(p) {
      return p.mode == 'ADVANCE';
    }
    function advanceCount(ps) {
      return ps.size() == 0 ? 0
        : ps.size() == 1 ? (isAdv(ps[0]) ? 1 : 0)
        : ps.size() == 2 ? (isAdv(ps[0]) ? 1 : 0) + (isAdv(ps[1]) ? 1 : 0)
        : ps.size() == 3 ? (isAdv(ps[0]) ? 1 : 0) + (isAdv(ps[1]) ? 1 : 0) + (isAdv(ps[2]) ? 1 : 0)
        : (isAdv(ps[0]) ? 1 : 0) + (isAdv(ps[1]) ? 1 : 0) + (isAdv(ps[2]) ? 1 : 0) + (isAdv(ps[3]) ? 1 : 0);
    }
    function advanceSum(ps) {
      return ps.size() == 0 ? 0
        : ps.size() == 1 ? (isAdv(ps[0]) ? ps[0].amount : 0)
        : ps.size() == 2 ? (isAdv(ps[0]) ? ps[0].amount : 0) + (isAdv(ps[1]) ? ps[1].amount : 0)
        : ps.size() == 3 ? (isAdv(ps[0]) ? ps[0].amount : 0) + (isAdv(ps[1]) ? ps[1].amount : 0) + (isAdv(ps[2]) ? ps[2].amount : 0)
        : (isAdv(ps[0]) ? ps[0].amount : 0) + (isAdv(ps[1]) ? ps[1].amount : 0) + (isAdv(ps[2]) ? ps[2].amount : 0) + (isAdv(ps[3]) ? ps[3].amount : 0);
    }

    // An ordinary bill's payments (#19): like paymentsOk, and no entry is
    // ADVANCE. Fused with the sum so the list is dispatched on size() once
    // (the bill rule is the tightest, see the header).
    function paymentsOkNoAdvance(ps, total) {
      return ps is list && ps.size() <= 4
        && (ps.size() == 0 ? total == 0
          : ps.size() == 1 ? ps[0].amount == total && ps[0].mode != 'ADVANCE'
          : ps.size() == 2 ? ps[0].amount + ps[1].amount == total
            && ps[0].mode != 'ADVANCE' && ps[1].mode != 'ADVANCE'
          : ps.size() == 3 ? ps[0].amount + ps[1].amount + ps[2].amount == total
            && ps[0].mode != 'ADVANCE' && ps[1].mode != 'ADVANCE' && ps[2].mode != 'ADVANCE'
          : ps[0].amount + ps[1].amount + ps[2].amount + ps[3].amount == total
            && ps[0].mode != 'ADVANCE' && ps[1].mode != 'ADVANCE' && ps[2].mode != 'ADVANCE'
            && ps[3].mode != 'ADVANCE');
    }

    // #19. Without an orderId no payment is ADVANCE. With one, the order
    // must be OPEN before the batch and DELIVERED after it, naming this bill,
    // and the payments hold exactly one ADVANCE entry equal to the order's
    // advance (none when the advance is 0).
    function paymentsAndOrderOk(loc, billId, b) {
      return b.get('orderId', null) != null
        ? paymentsOk(b.payments, b.total)
          && b.orderId is string && b.orderId.matches('^D[0-9]{2}-O[0-9]{6}$')
          && orderDelivers(loc, billId, b.orderId, b.payments)
        : paymentsOkNoAdvance(b.payments, b.total);
    }
    function orderDelivers(loc, billId, orderId, ps) {
      let before = get(orderPath(loc, orderId)).data;
      let after = getAfter(orderPath(loc, orderId)).data;
      return before.status == 'OPEN'
        && after.status == 'DELIVERED'
        && after.billId == billId
        && (before.advance == 0
          ? advanceCount(ps) == 0
          : advanceCount(ps) == 1 && advanceSum(ps) == before.advance);
    }

    // The customer on a new bill (D-034, D-037): a trimmed name of 1-60
    // characters, a mobile number, a WhatsApp number that is null or a mobile
    // number, and a customerId that starts with `{customerPhone}_`. The
    // 10-hex name key after it is the client's (D-031); rule #14 checks the
    // customer doc against these fields.
    function validBillCustomer(b) {
      return b.customerName is string && b.customerName.size() >= 1 && b.customerName.size() <= 60
        && b.customerName == b.customerName.trim()
        && b.customerPhone is string && b.customerPhone.matches('^[6-9][0-9]{9}$')
        && (b.customerWhatsapp == null
          || (b.customerWhatsapp is string && b.customerWhatsapp.matches('^[6-9][0-9]{9}$')))
        && b.customerId is string
        && b.customerId.matches('^[6-9][0-9]{9}_[0-9a-f]{10}$')
        && b.customerId.matches('^' + b.customerPhone + '_.*');
    }

    // #6. billId is `D01-000123` and must agree with deviceId, seq and billNo.
    function validNewBill(loc, billId) {
      let b = incoming();
      let keys = billKeys();
      return billId.matches('^D[0-9]{2}-[0-9]{6}$')
        && b.keys().hasOnly(keys.concat(billOptionalKeys()))
        && b.keys().hasAll(keys)
        && b.billNo == loc + '-' + billId
        && b.deviceId == billId.split('-')[0]
        && b.seq is int && b.seq > 0
        && billId.matches('^D[0-9]{2}-0*' + string(b.seq) + '$')
        && b.createdBy == request.auth.uid
        && b.status == 'COMPLETED'
        && b.cancel == null
        && b.returnedQty is map && b.returnedQty.size() == 0
        && b.lastReturnId == null
        && billLinesOk(b.lines, b.soldQty)
        && validBillCustomer(b)
        && b.subtotal is int
        && (b.discount == null || b.discount is map)
        && b.taxableValue is int
        && b.taxLines is list
        && b.roundOff is int
        && (b.cashTendered == null || b.cashTendered is int)
        && b.servedBy is map
        && b.total is int && b.total >= 0 && b.total % 100 == 0
        && paymentsAndOrderOk(loc, billId, b)
        && isBusinessDate(b.businessDate)
        && b.clientCreatedAt is timestamp
        && b.serverCreatedAt == request.time;
    }

    // #5(a). Same-day cancel. D-009's "same day" is client-enforced (D-031);
    // the rule keeps cancel.businessDate equal to the bill's own.
    function isCancel(loc, billId) {
      let c = incoming().cancel;
      return changed().hasOnly(['status', 'cancel'])
        && canAt('bill.cancel', loc)
        && resource.data.status == 'COMPLETED'
        && incoming().status == 'CANCELLED'
        && resource.data.returnedQty.size() == 0
        // A bill that delivers a pre-order can't be cancelled (D-043 (d)):
        // its advance was taken on another day.
        && resource.data.get('orderId', null) == null
        && c is map
        && c.keys().hasOnly(['reason', 'by', 'at', 'businessDate'])
        && c.keys().hasAll(['reason', 'by', 'at', 'businessDate'])
        && c.reason is string && c.reason.size() > 0
        && c.by == request.auth.uid
        && c.at is timestamp
        && c.businessDate == resource.data.businessDate
        && existsAfter(movementPath(loc, billId + '-X'))
        && existsAfter(auditPath(loc + '-' + billId + '-X'));
    }

    // Product p's new returnedQty: never lower than before, never above what
    // was sold (a product not on the bill has sold 0).
    function returnedQtyOk(p, rq, old, sold) {
      return rq[p] >= old.get(p, 0) && rq[p] <= sold.get(p, 0);
    }
    function returnedQtyFrom0(ks, n, rq, old, sold) {
      return returnedQtyOk(ks[0], rq, old, sold)
          && (n == 1 ? true : returnedQtyOk(ks[1], rq, old, sold)
          && (n == 2 ? true : returnedQtyOk(ks[2], rq, old, sold)
          && (n == 3 ? true : returnedQtyOk(ks[3], rq, old, sold)
          && (n == 4 ? true : returnedQtyOk(ks[4], rq, old, sold)
          && (n == 5 ? true : returnedQtyFrom5(ks, n, rq, old, sold))))));
    }
    function returnedQtyFrom5(ks, n, rq, old, sold) {
      return returnedQtyOk(ks[5], rq, old, sold)
          && (n == 6 ? true : returnedQtyOk(ks[6], rq, old, sold)
          && (n == 7 ? true : returnedQtyOk(ks[7], rq, old, sold)
          && (n == 8 ? true : returnedQtyOk(ks[8], rq, old, sold)
          && (n == 9 ? true : returnedQtyOk(ks[9], rq, old, sold)
          && (n == 10 ? true : returnedQtyFrom10(ks, n, rq, old, sold))))));
    }
    function returnedQtyFrom10(ks, n, rq, old, sold) {
      return returnedQtyOk(ks[10], rq, old, sold)
          && (n == 11 ? true : returnedQtyOk(ks[11], rq, old, sold)
          && (n == 12 ? true : returnedQtyOk(ks[12], rq, old, sold)
          && (n == 13 ? true : returnedQtyOk(ks[13], rq, old, sold)
          && (n == 14 ? true : returnedQtyOk(ks[14], rq, old, sold)))));
    }

    // #5(b). A return raises returnedQty, tied to a return doc created in the
    // same batch (lastReturnId). First to sync wins against a cancel or a
    // stale return (D-029).
    function isReturnUpdate(loc) {
      let rq = incoming().returnedQty;
      let ks = rq.keys();
      let r = incoming().lastReturnId;
      // Both fields must change: a return always raises some quantity. No
      // separate type or format checks on rq and r: a non-map rq, an empty
      // one or a non-string r makes an expression below fail, which denies.
      // Every evaluated expression counts, and this is the tightest rule.
      let ch = changed();
      return ch.hasOnly(['returnedQty', 'lastReturnId'])
        && ch.hasAll(['returnedQty', 'lastReturnId'])
        && canAt('return.create', loc)
        && resource.data.status == 'COMPLETED'
        && ks.hasAll(resource.data.returnedQty.keys())
        && ks.size() <= resource.data.soldQty.size()
        && returnedQtyFrom0(ks, ks.size(), rq, resource.data.returnedQty, resource.data.soldQty)
        && !exists(returnPath(loc, r))
        && existsAfter(returnPath(loc, r))
        // The return was worked out from the bill as it is now, not from a
        // stale copy: its prevReturnId is the bill's current lastReturnId
        // (both null for the first return). Same doc as existsAfter, so no
        // extra access call (QA-024).
        && getAfter(returnPath(loc, r)).data.prevReturnId == resource.data.lastReturnId;
    }


    // ---- #7 returns and movements, #8 stock ------------------------------

    function returnKeys() {
      return ['billId', 'billNo', 'lines', 'refundTotal', 'refunds', 'reason', 'prevReturnId',
              'businessDate', 'createdBy', 'deviceId', 'clientCreatedAt', 'serverCreatedAt'];
    }

    // #7. A return has 1-15 lines (a bill's cap, D-030). It is created together with the bill update that raises
    // returnedQty (the bill must name it as lastReturnId after the batch;
    // #5(b) checks the rest) and its audit doc (#10, D-028).
    function validNewReturn(loc, returnId) {
      let r = incoming();
      let keys = returnKeys();
      return returnId.matches('^D[0-9]{2}-R[0-9]{6}$')
        && r.keys().hasOnly(keys)
        && r.keys().size() == keys.size()
        && r.deviceId == returnId.split('-')[0]
        && r.billId is string && r.billId.matches('^D[0-9]{2}-[0-9]{6}$')
        && r.billNo == loc + '-' + r.billId
        && r.createdBy == request.auth.uid
        && r.lines is list && r.lines.size() >= 1 && r.lines.size() <= 15
        && r.refundTotal is int && r.refundTotal >= 0 && r.refundTotal % 100 == 0
        && paymentsOk(r.refunds, r.refundTotal)
        && r.reason is string
        && (r.prevReturnId == null || r.prevReturnId is string)
        && isBusinessDate(r.businessDate)
        && r.clientCreatedAt is timestamp
        && r.serverCreatedAt == request.time
        && getAfter(billPath(loc, r.billId)).data.lastReturnId == returnId
        // No refund above the bill's total (QA-040, D-024). A bill's total
        // never changes after create, so this reads the same doc as the
        // line above and costs no extra access call.
        && r.refundTotal <= getAfter(billPath(loc, r.billId)).data.total
        && existsAfter(auditPath(loc + '-' + returnId));
    }

    function movementKeys() {
      return ['type', 'lines', 'reason', 'note', 'refId', 'businessDate',
              'clientCreatedAt', 'serverCreatedAt', 'createdBy', 'deviceId'];
    }
    // The permission each movement type needs (#7).
    function movementPermission(t) {
      return t == 'SALE' ? 'bill.create'
        : t == 'CANCEL' ? 'bill.cancel'
        : t == 'RETURN' ? 'return.create'
        : t == 'ADJUST' ? 'stock.adjust'
        : 'stock.move';
    }
    // SALE, RETURN and CANCEL movements share their bill's or return's ID
    // (02-DATA-MODEL); the rest use the device's movement counter.
    function movementIdPattern(t) {
      return t == 'SALE' ? '^D[0-9]{2}-[0-9]{6}$'
        : t == 'CANCEL' ? '^D[0-9]{2}-[0-9]{6}-X$'
        : t == 'RETURN' ? '^D[0-9]{2}-R[0-9]{6}$'
        : '^D[0-9]{2}-M[0-9]{6}$';
    }

    function validNewMovement(loc, id) {
      let m = incoming();
      let t = m.type;
      let keys = movementKeys();
      return m.keys().hasOnly(keys)
        && m.keys().size() == keys.size()
        && t in ['STOCK_IN', 'STOCK_OUT_RAW', 'WASTAGE_RAW', 'PRODUCE', 'WASTAGE_FG',
                 'ADJUST', 'SALE', 'RETURN', 'CANCEL']
        && canAt(movementPermission(t), loc)
        && id.matches(movementIdPattern(t))
        && m.deviceId is string && m.deviceId.matches('^D[0-9]{2}$')
        // A cancel can be made on another device than the bill's.
        && (t == 'CANCEL' || m.deviceId == id.split('-')[0])
        && (t == 'SALE' || t == 'RETURN' ? m.refId == id
          : t == 'CANCEL' ? m.refId + '-X' == id
          : true)
        && m.createdBy == request.auth.uid
        && m.lines is list && m.lines.size() >= 1 && m.lines.size() <= 20
        && (t in ['WASTAGE_RAW', 'WASTAGE_FG', 'ADJUST', 'CANCEL']
          ? m.reason is string && m.reason.size() > 0
          : true)
        // Wastage and adjustments are audited (#10, D-028).
        && (t in ['WASTAGE_RAW', 'WASTAGE_FG', 'ADJUST']
          ? existsAfter(auditPath(loc + '-' + id))
          : true)
        // SALE, RETURN and CANCEL move stock only as part of their bill,
        // return or cancellation, in the same batch (QA-038): a new bill or
        // return with the movement's ID, or the bill named by refId going
        // COMPLETED -> CANCELLED.
        && (t == 'SALE' ? !exists(billPath(loc, id)) && existsAfter(billPath(loc, id))
          : t == 'RETURN' ? !exists(returnPath(loc, id)) && existsAfter(returnPath(loc, id))
          : t == 'CANCEL' ? get(billPath(loc, m.refId)).data.status == 'COMPLETED'
            && getAfter(billPath(loc, m.refId)).data.status == 'CANCELLED'
          : true)
        && isBusinessDate(m.businessDate)
        && m.clientCreatedAt is timestamp
        && m.serverCreatedAt == request.time;
    }

    function stockKeys() {
      return ['kind', 'refId', 'name', 'unit', 'qty', 'lastMovementId', 'updatedAt', 'lowThreshold'];
    }

    // #8, for the keys a stock write sets (create) or changes (update):
    // - qty and lastMovementId only with a movement that is new in this
    //   batch, so every quantity change has a movement doc behind it;
    // - lowThreshold only with stock.threshold;
    // - updatedAt is the server time.
    function stockChangeOk(loc, ks) {
      let d = incoming();
      return (!ks.hasAny(['qty', 'lastMovementId'])
          || (d.qty is int && d.lastMovementId is string
            && !exists(movementPath(loc, d.lastMovementId))
            && existsAfter(movementPath(loc, d.lastMovementId))))
        && (!ks.hasAny(['lowThreshold'])
          || (canAt('stock.threshold', loc)
            && (d.lowThreshold == null || (d.lowThreshold is int && d.lowThreshold >= 0))))
        && (!ks.hasAny(['updatedAt']) || d.updatedAt == request.time)
        && (!ks.hasAny(['name']) || d.name is string);
    }

    // Every batch writes the stock doc with set(merge) and qty as an
    // increment (D-005), so the first use creates it. The itemKey is
    // RM_{materialId} or FG_{productId}.
    function validNewStock(loc, itemKey) {
      let d = incoming();
      return d.keys().hasOnly(stockKeys())
        && d.keys().hasAll(['kind', 'refId', 'name', 'unit', 'updatedAt'])
        && d.kind in ['RAW', 'FINISHED']
        && d.unit in ['G', 'ML', 'PCS']
        && d.refId is string
        && itemKey == (d.kind == 'RAW' ? 'RM_' : 'FG_') + d.refId
        && stockChangeOk(loc, d.keys());
    }

    // ---- #9 summaries ----------------------------------------------------

    function summaryKeys() {
      return ['billCount', 'cancelCount', 'returnCount', 'grossSales', 'discounts', 'roundOff',
              'netSales', 'returns', 'cancelled', 'byMode', 'byProduct', 'expenses',
              'byExpenseCategory', 'advanceReceived', 'advanceRefunded', 'lastWriteRef'];
    }

    // How much a summary write changes a number field. A set(merge) with
    // increment() reaches the rules as the resulting value, so the change is
    // the new value minus the stored one (0 for a doc that doesn't exist yet).
    function summaryDelta(f) {
      return incoming().get(f, 0) - (resource == null ? 0 : resource.data.get(f, 0));
    }

    // #9. Every summary write names, in lastWriteRef, the doc that caused
    // it: a bill, return or CANCEL movement (`{billId}-X`; no other
    // movement, QA-039) at this location, or an expense
    // audit doc (`{loc}-EXP-...`, D-032; an edit that moves an expense to
    // another location ties both summaries to the one audit doc). That doc must be new in this batch, which ties each
    // increment to exactly one business event. The numbers themselves are
    // increments the rules can't see, except the two advance fields (#20,
    // D-043), which only a pre-order can move: a new order (with an advance)
    // raises advanceReceived by its advance, and a cancelled order's audit
    // entry `{loc}-{orderId}-X` raises advanceRefunded by what it refunded.
    // QA-5 reconciles the rest.
    function docPath(ref) {
      return path('/databases/' + database + '/documents/' + ref);
    }
    function validSummaryWrite(loc) {
      let ref = incoming().lastWriteRef;
      let refIsOrder = ref is string && ref.matches('^locations/' + loc + '/orders/D[0-9]{2}-O[0-9]{6}$');
      let refIsCancel = ref is string && ref.matches('^auditLog/' + loc + '-D[0-9]{2}-O[0-9]{6}-X$');
      return activeAt(loc)
        && incoming().keys().hasOnly(summaryKeys())
        && ref is string
        && (ref.matches('^locations/' + loc + '/((bills|returns)/[A-Za-z0-9-]+|movements/D[0-9]{2}-[0-9]{6}-X|orders/D[0-9]{2}-O[0-9]{6})$')
          || ref.matches('^auditLog/[A-Z]{2,4}-EXP-[A-Za-z0-9_-]+$')
          || refIsCancel)
        && !exists(docPath(ref))
        && existsAfter(docPath(ref))
        && (!ref.matches('^auditLog/.*$')
          || (refIsCancel
            ? getAfter(docPath(ref)).data.action == 'ORDER_CANCEL'
            : getAfter(docPath(ref)).data.action in ['EXPENSE_CREATE', 'EXPENSE_UPDATE']))
        && validAdvanceDeltas(loc, ref, refIsOrder, refIsCancel);
    }

    // #20. advanceReceived moves only with a new order, by exactly its
    // advance; advanceRefunded only with a cancellation's audit entry, by
    // exactly the order's refund. Every other write leaves both alone.
    function validAdvanceDeltas(loc, ref, refIsOrder, refIsCancel) {
      return summaryDelta('advanceReceived') == (refIsOrder ? getAfter(docPath(ref)).data.advance : 0)
        && summaryDelta('advanceRefunded') == (refIsCancel ? cancelledRefund(loc, ref) : 0);
    }
    // `auditLog/PTB-D01-O000007-X` is the cancellation of order D01-O000007.
    function cancelledRefund(loc, ref) {
      let parts = ref.split('/')[1].split('-');
      let o = getAfter(orderPath(loc, parts[1] + '-' + parts[2])).data;
      return o.status == 'CANCELLED' ? o.cancel.refunded : null;
    }

    // ---- #10 auditLog ------------------------------------------------------

    function auditKeys() {
      return ['action', 'entityPath', 'locationId', 'before', 'after', 'reason', 'by',
              'deviceId', 'clientAt', 'at'];
    }
    // #10 (D-032). Every action needs its own permission, at the location
    // for location-scoped events (QA-037).
    function auditPermission(action) {
      return action == 'STOCK_ADJUST' ? 'stock.adjust'
        : action == 'WASTAGE' ? 'stock.move'
        : action == 'BILL_CANCEL' ? 'bill.cancel'
        : action == 'RETURN' ? 'return.create'
        : action == 'OFFLINE_OVERRIDE' ? 'bill.create'
        : action == 'ORDER_CANCEL' ? 'order.manage'
        : action == 'THRESHOLD_CHANGE' ? 'stock.threshold'
        : action in ['EXPENSE_CREATE', 'EXPENSE_UPDATE'] ? 'expense.manage'
        : action in ['PRICE_CHANGE', 'PRODUCT_APPROVE', 'PRODUCT_DECLINE'] ? 'catalog.manage'
        : action in ['USER_CREATE', 'USER_DISABLE', 'USER_ENABLE'] ? 'user.manage'
        : 'location.manage';
    }

    // The ID shape after `{loc}-` for each location-scoped action, from the
    // D-032 table in 02-DATA-MODEL. Tying action to shape stops an audit doc
    // of one action from taking another action's ID (QA-044).
    function auditIdShape(action) {
      return action == 'BILL_CANCEL' ? 'D[0-9]{2}-[0-9]{6}-X'
        : action == 'RETURN' ? 'D[0-9]{2}-R[0-9]{6}'
        : action in ['STOCK_ADJUST', 'WASTAGE'] ? 'D[0-9]{2}-M[0-9]{6}'
        : action == 'OFFLINE_OVERRIDE' ? 'D[0-9]{2}-OVR-[0-9]+'
        : action == 'ORDER_CANCEL' ? 'D[0-9]{2}-O[0-9]{6}-X'
        : action in ['EXPENSE_CREATE', 'EXPENSE_UPDATE'] ? 'EXP-[A-Za-z0-9_-]+-[0-9]+'
        : action == 'LOCATION_UPDATE' ? 'LOC-[0-9]+'
        : 'USR-[A-Za-z0-9_-]+-[0-9]+';
    }

    // IDs (D-028, D-032): a location-scoped event is `{loc}-...` with
    // locationId set; PRICE_CHANGE, PRODUCT_APPROVE and PRODUCT_DECLINE are
    // global (`PRICE-...`, `APPROVE-...`, `DECLINE-{productId}-{millis}`,
    // locationId null); a user event is
    // `{loc}-USR-...` for a user with a location, or `USR-...` without.
    function validNewAudit(auditId) {
      let a = incoming();
      let keys = auditKeys();
      let p = auditPermission(a.action);
      let global = a.action in ['PRICE_CHANGE', 'PRODUCT_APPROVE', 'PRODUCT_DECLINE'];
      let userEvent = a.action in ['USER_CREATE', 'USER_DISABLE', 'USER_ENABLE'];
      let scoped = a.locationId is string && isLocationCode(a.locationId)
        && canAt(p, a.locationId)
        && auditId.matches('^' + a.locationId + '-' + auditIdShape(a.action) + '$');
      return a.keys().hasOnly(keys)
        && a.keys().size() == keys.size()
        && a.action in ['STOCK_ADJUST', 'WASTAGE', 'BILL_CANCEL', 'RETURN', 'EXPENSE_CREATE',
                        'EXPENSE_UPDATE', 'PRICE_CHANGE', 'PRODUCT_APPROVE', 'PRODUCT_DECLINE', 'USER_CREATE',
                        'USER_DISABLE', 'USER_ENABLE', 'OFFLINE_OVERRIDE', 'LOCATION_UPDATE', 'ORDER_CANCEL']
        && a.by == request.auth.uid
        && a.at == request.time
        && a.clientAt is timestamp
        && a.entityPath is string
        && (global
              ? a.locationId == null && can(p)
                && (a.action == 'PRODUCT_DECLINE'
                  ? auditId.matches('^DECLINE-[A-Za-z0-9_-]+-[0-9]+$')
                  : auditId.matches('^' + (a.action == 'PRICE_CHANGE' ? 'PRICE' : 'APPROVE') + '-.+$'))
            : userEvent
              ? (a.locationId == null
                  ? can(p) && auditId.matches('^USR-.+$')
                  : scoped && auditId.matches('^' + a.locationId + '-USR-.+$'))
            : scoped);
    }

    // ---- #11 products and raw materials ------------------------------------

    function productKeys() {
      return ['name', 'category', 'price', 'proposedPrice', 'unit', 'gstRate', 'scope', 'status',
              'recipe', 'sortOrder', 'createdBy', 'createdAt', 'updatedAt'];
    }
    // `openPrice` (D-043): the price is typed at the counter, as for the
    // seeded CUSTOM-CAKE. Optional, a bool, and true only with catalog.manage
    // (a suggestion can't set it, see isSuggestion).
    function productOptionalKeys() {
      return ['openPrice'];
    }
    // Set by an approval or a decline only (D-038).
    function reviewKeys() {
      return ['reviewedBy', 'reviewNote', 'reviewedAt'];
    }
    function isSafeKey(s) {
      return s.matches('^[A-Za-z0-9_-]{1,100}$');
    }
    function validProductFields(d) {
      return d.name is string && d.name.size() > 0
        && d.category is string
        && (d.price == null || (d.price is int && d.price >= 0))
        && (d.proposedPrice == null || (d.proposedPrice is int && d.proposedPrice >= 0))
        && d.unit == 'PCS'
        && d.status in ['ACTIVE', 'PENDING', 'INACTIVE']
        && (d.scope == 'GLOBAL' || isLocationCode(d.scope))
        && d.sortOrder is int
        && d.get('openPrice', false) is bool
        && (d.get('openPrice', false) == false || can('catalog.manage'))
        && d.updatedAt == request.time;
    }
    // A Store Manager's suggestion: PENDING, no price yet, scoped to their own
    // location (D-008).
    function isSuggestion(d) {
      return can('catalog.suggest')
        && d.status == 'PENDING'
        && d.price == null
        && d.get('openPrice', false) == false
        && d.scope == me().locationId;
    }

    // ---- #12 expenses --------------------------------------------------------

    function validExpenseFields(d) {
      return d.keys().hasOnly(['locationId', 'category', 'amount', 'date', 'note', 'createdBy', 'createdAt', 'updatedAt'])
        && isLocationCode(d.locationId) && atLoc(d.locationId)
        && d.category in ['RENT', 'SALARY', 'UTILITIES', 'OTHER']
        && d.amount is int && d.amount >= 0
        && isBusinessDate(d.date)
        && d.note is string
        && d.updatedAt == request.time;
    }

    // #11. The Admin's decision on a PENDING suggestion (D-038). Approve and
    // decline are the only edits to a PENDING product: approve prices it and
    // makes it ACTIVE, decline makes it INACTIVE with a note of 1-200 trimmed
    // characters. Both stamp the reviewer and the server time. (The audit doc
    // has a client-time ID, so rule #10 can't be tied to it here, as with
    // PRICE_CHANGE.)
    function isApprove() {
      let d = incoming();
      let ch = changed();
      return ch.hasOnly(['status', 'price', 'reviewedBy', 'reviewedAt', 'updatedAt'])
        && ch.hasAll(['status', 'price', 'reviewedAt'])
        && d.status == 'ACTIVE'
        && d.price is int && d.price > 0
        && d.reviewedBy == request.auth.uid
        && d.reviewedAt == request.time;
    }
    function isDecline() {
      let d = incoming();
      let ch = changed();
      return ch.hasOnly(['status', 'reviewNote', 'reviewedBy', 'reviewedAt', 'updatedAt'])
        && ch.hasAll(['status', 'reviewNote', 'reviewedAt'])
        && d.status == 'INACTIVE'
        && d.reviewNote is string && d.reviewNote.size() >= 1 && d.reviewNote.size() <= 200
        && d.reviewNote == d.reviewNote.trim()
        && d.reviewedBy == request.auth.uid
        && d.reviewedAt == request.time;
    }

    match /auditLog/{auditId} {
      // Admin-style roles read every location's entries; a role with
      // audit.view scoped to one location reads only that location's.
      allow read: if can('audit.view') && (role().allLocations == true || resource.data.locationId == me().locationId);
      allow create: if validNewAudit(auditId);
      allow update, delete: if false;
    }

    match /products/{productId} {
      allow read: if can('catalog.view');
      allow create: if isSafeKey(productId)
        && incoming().keys().hasOnly(productKeys().concat(productOptionalKeys()))
        && incoming().keys().hasAll(productKeys())
        && validProductFields(incoming())
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && (can('catalog.manage') || isSuggestion(incoming()));
      // Prices, approval, deactivation and edits (#11). createdBy and
      // createdAt never change.
      // A PENDING product is only approved or declined (D-038), and no other
      // edit touches the review fields.
      allow update: if can('catalog.manage')
        && !changed().hasAny(['createdBy', 'createdAt'])
        && incoming().keys().hasOnly(productKeys().concat(productOptionalKeys()).concat(reviewKeys()))
        && validProductFields(incoming())
        && (resource.data.status == 'PENDING'
          ? isApprove() || isDecline()
          : !changed().hasAny(reviewKeys()));
      allow delete: if false;
    }

    match /rawMaterials/{materialId} {
      allow read: if can('catalog.view');
      allow create: if can('rawMaterial.create')
        && isSafeKey(materialId)
        && incoming().keys().hasOnly(['name', 'unit', 'active', 'createdBy'])
        && incoming().name is string && incoming().name.size() > 0
        && incoming().unit in ['G', 'ML', 'PCS']
        && incoming().active == true
        && incoming().createdBy == request.auth.uid;
      // Renaming and deactivating are catalog management; the unit is fixed
      // because stock quantities are counted in it.
      allow update: if can('catalog.manage')
        && changed().hasOnly(['name', 'active'])
        && incoming().name is string && incoming().name.size() > 0
        && incoming().active is bool;
      allow delete: if false;
    }

    match /expenses/{expenseId} {
      allow read: if can('expense.manage') && atLoc(resource.data.locationId);
      allow create: if can('expense.manage')
        && isSafeKey(expenseId)
        && validExpenseFields(incoming())
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time;
      allow update: if can('expense.manage')
        && !changed().hasAny(['createdBy', 'createdAt'])
        && validExpenseFields(incoming());
      allow delete: if false;
    }

    match /locations/{loc} {
      allow read: if activeAt(loc);

      allow create: if can('location.manage')
        && isLocationCode(loc)
        && incoming().keys().hasOnly(locationKeys())
        && incoming().keys().hasAll(locationKeys())
        && incoming().code == loc
        && incoming().nextDeviceNo == 0
        && validLocationFields(incoming());

      allow update: if isRegistration(loc)
        || (canAt('location.manage', loc)
          && !changed().hasAny(['code', 'nextDeviceNo'])
          && incoming().keys().hasOnly(locationKeys())
          && validLocationFields(incoming()));

      allow delete: if false;

      match /bills/{billId} {
        allow read: if canAt('report.own', loc) || canAt('bill.create', loc) || canAt('return.create', loc);
        // A create on an existing ID is an update, which fails validation, so
        // a duplicate bill is denied (the !exists of #5).
        allow create: if canAt('bill.create', loc) && validNewBill(loc, billId);
        // The return check goes first: it's the bigger one, and a cancel
        // fails its first clause cheaply.
        allow update: if isReturnUpdate(loc) || isCancel(loc, billId);
        allow delete: if false;
      }

      match /returns/{returnId} {
        allow read: if canAt('report.own', loc) || canAt('bill.create', loc) || canAt('return.create', loc);
        allow create: if canAt('return.create', loc) && validNewReturn(loc, returnId);
        allow update, delete: if false;
      }

      match /movements/{movementId} {
        allow read: if canAt('stock.move', loc) || canAt('stock.adjust', loc) || canAt('report.own', loc);
        allow create: if validNewMovement(loc, movementId);
        allow update, delete: if false;
      }

      match /stock/{itemKey} {
        allow read: if canAt('catalog.view', loc);
        allow create: if activeAt(loc) && validNewStock(loc, itemKey);
        // kind, refId and unit are create-only; name may change on any write,
        // so a renamed product keeps selling (QA-023).
        allow update: if activeAt(loc)
          && changed().hasOnly(['name', 'qty', 'lastMovementId', 'updatedAt', 'lowThreshold'])
          && stockChangeOk(loc, changed());
        allow delete: if false;
      }

      // ---- #14 customers (D-037) ----------------------------------------
      // One record per mobile number and name, written only by a bill's batch
      // (see validCustomerWrite). Read by the staff who bill or report at the
      // location, and by report.all everywhere (also as a collection group,
      // below).
      match /customers/{customerId} {
        allow read: if canAt('bill.create', loc) || canAt('report.own', loc) || can('report.all');
        // The first bill: billCount 1 and totalSpend that bill's total.
        allow create: if validCustomerWrite(loc, customerId, customerBill(loc))
          && incoming().billCount == 1
          && incoming().totalSpend == customerBill(loc).total;
        // Later bills: the counters go up by exactly this bill's count and
        // total. name and phone never change (the name's letter case may, see
        // validCustomerWrite).
        allow update: if validCustomerWrite(loc, customerId, customerBill(loc))
          && changed().hasOnly(['name', 'whatsapp', 'lastBillAt', 'lastWriteRef', 'billCount', 'totalSpend'])
          && incoming().name.lower() == resource.data.name.lower()
          && incoming().billCount == resource.data.billCount + 1
          && incoming().totalSpend == resource.data.totalSpend + customerBill(loc).total;
        allow delete: if false;
      }

      // ---- #15 staff roster (D-042) --------------------------------------
      // The Admin keeps it; staff are deactivated, never deleted. Read by
      // whoever marks, manages or reports at the location, and by report.all
      // everywhere.
      match /staff/{staffId} {
        allow read: if canAt('attendance.mark', loc) || canAt('staff.manage', loc)
          || canAt('report.own', loc) || can('report.all');
        allow create: if isSafeKey(staffId) && validNewStaff(loc);
        allow update: if validStaffUpdate(loc);
        allow delete: if false;
      }

      // ---- #16 attendance (D-042) -----------------------------------------
      match /attendance/{docId} {
        allow read: if canAt('attendance.mark', loc) || canAt('report.own', loc) || can('report.all');
        // set() of the whole doc: a first mark creates it, a correction
        // replaces it, so one rule covers both.
        allow create, update: if canAt('attendance.mark', loc) && validAttendance(docId);
        allow delete: if false;
      }

      // ---- #18 pre-orders (D-043) ------------------------------------------
      match /orders/{orderId} {
        allow read: if canAt('order.manage', loc) || canAt('report.own', loc) || can('report.all');
        allow create: if canAt('order.manage', loc) && validNewOrder(loc, orderId);
        allow update: if isOrderDeliver(loc, orderId) || isOrderCancel(loc, orderId);
        allow delete: if false;
      }

      match /dailySummary/{day} {
        allow read: if canAt('report.own', loc);
        allow create, update: if isBusinessDate(day) && validSummaryWrite(loc);
        allow delete: if false;
      }

      match /monthlySummary/{month} {
        allow read: if canAt('report.own', loc);
        allow create, update: if month.matches('^[0-9]{4}-[0-9]{2}$') && validSummaryWrite(loc);
        allow delete: if false;
      }

      match /devices/{deviceId} {
        allow read: if canAt('device.register', loc) || canAt('location.manage', loc);

        // Only as the other half of isRegistration(): the ID is the location's
        // new nextDeviceNo, and the device starts clean.
        allow create: if canAt('device.register', loc)
          && getAfter(locationPath(loc)).data.nextDeviceNo == get(locationPath(loc)).data.nextDeviceNo + 1
          && deviceId == deviceCode(getAfter(locationPath(loc)).data.nextDeviceNo)
          && incoming().keys().hasOnly(['code', 'label', 'registeredBy', 'registeredAt', 'lastSeenAt',
                                        'lastBillSeq', 'lastMovementSeq', 'lastReturnSeq', 'lastOrderSeq', 'retired'])
          && incoming().code == deviceId
          && incoming().label is string
          && incoming().registeredBy == request.auth.uid
          && incoming().registeredAt == request.time
          && incoming().get('lastSeenAt', request.time) == request.time
          && incoming().get('lastBillSeq', 0) == 0
          && incoming().get('lastMovementSeq', 0) == 0
          && incoming().get('lastReturnSeq', 0) == 0
          && incoming().get('lastOrderSeq', 0) == 0
          && incoming().retired == false;

        // Each field has its own writer. The sequence fields only go up.
        allow update: if activeAt(loc)
          && changed().hasOnly(['lastBillSeq', 'lastMovementSeq', 'lastReturnSeq', 'lastOrderSeq', 'lastSeenAt', 'label', 'retired'])
          && (!changed().hasAny(['lastBillSeq'])
            || (can('bill.create') && incoming().lastBillSeq is int
              && incoming().lastBillSeq > resource.data.get('lastBillSeq', 0)))
          && (!changed().hasAny(['lastMovementSeq'])
            || ((can('stock.move') || can('stock.adjust')) && incoming().lastMovementSeq is int
              && incoming().lastMovementSeq > resource.data.get('lastMovementSeq', 0)))
          && (!changed().hasAny(['lastReturnSeq'])
            || (can('return.create') && incoming().lastReturnSeq is int
              && incoming().lastReturnSeq > resource.data.get('lastReturnSeq', 0)))
          && (!changed().hasAny(['lastOrderSeq'])
            || (can('order.manage') && incoming().lastOrderSeq is int
              && incoming().lastOrderSeq > resource.data.get('lastOrderSeq', 0)))
          && (!changed().hasAny(['lastSeenAt']) || incoming().lastSeenAt == request.time)
          && (!changed().hasAny(['label', 'retired'])
            || (can('location.manage') && incoming().label is string && incoming().retired is bool));

        allow delete: if false;
      }
    }

    // ---- #14 customers: every location at once (collection group) ----------
    // A collectionGroup('customers') query is allowed by this rule only, and
    // only with report.all. Single-location reads use the rule under
    // locations/{loc}.
    match /{path=**}/customers/{customerId} {
      allow read: if can('report.all');
    }

    // The Admin's views across stores: one day's attendance
    // (`watchDayAllLocations`, by businessDate) and every store's pre-orders.
    // Each is allowed by its own rule and only with report.all; reads of one
    // location use the rules under locations/{loc}.
    match /{path=**}/attendance/{docId} {
      allow read: if can('report.all');
    }
    match /{path=**}/orders/{orderId} {
      allow read: if can('report.all');
    }
  }
}
