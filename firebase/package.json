{
  "name": "nexus-firestore-rules",
  "private": true,
  "description": "Firestore rules, indexes, tests and seed script for the Caramel Cottage retail system (BE-1 to BE-7, BE-14).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:emulator": "firebase emulators:exec --only firestore,auth --project demo-caramel-cottage \"vitest run\"",
    "budget": "node scripts/budget.mjs",
    "seed": "node scripts/seed.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.19.0",
    "firebase-admin": "^13.10.0",
    "vitest": "^4.1.11"
  }
}
